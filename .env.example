# Copy to .env and fill in values. Never commit .env.

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Cohere
COHERE_API_KEY=

# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX_HOST=

# MongoDB
MONGO_URI=
MONGO_DATABASE=

# AWS S3 — DS cache artifacts (entity + feature caches)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=chorus-ds-artifacts

# Redshift (Civic Shout mirror)
REDSHIFT_HOST=
REDSHIFT_PORT=5439
REDSHIFT_DATABASE=
REDSHIFT_USER=
REDSHIFT_PASSWORD=
REDSHIFT_SCHEMA=

# Budget
BUDGET_DOLLARS=50.0
COST_LEDGER_PATH=.costs/ledger.jsonl
