{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Ds3BucketList",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::chorus-ds-artifacts",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "autonomous-data-scientist/*",
            "data-science/*",
            "_healthcheck/*"
          ]
        }
      }
    },
    {
      "Sid": "Ds3ObjectRW",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::chorus-ds-artifacts/*"
    }
  ]
}
